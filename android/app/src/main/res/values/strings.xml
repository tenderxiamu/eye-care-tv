    <!-- 国产 ROM 教程 -->
    <string name="label_rom_guide">国产 ROM 保活教程</string>
    <string name="row_chevron">›</string>
    <string name="rom_guide_title">后台保活设置</string>
    <string name="rom_guide_xiaomi">小米 / Redmi：设置 → 应用设置 → 应用管理 → 护眼TV → 省电策略选「无限制」；自启动打开；最近任务里下拉应用卡片加锁。</string>
    <string name="rom_guide_huawei">华为 / 荣耀：设置 → 应用 → 应用启动管理 → 护眼TV 关闭「自动管理」，勾选手动管理三项；手机管家 → 应用启动管理中允许后台活动。</string>
    <string name="rom_guide_oppo">OPPO / realme / 一加：设置 → 电池 → 应用耗电管理 → 护眼TV 允许「后台运行」「自动启动」「关联启动」；最近任务里锁定应用。</string>
    <string name="rom_guide_vivo">vivo / iQOO：设置 → 电池 → 后台耗电管理 → 护眼TV 选「允许后台高耗电」；i管家 → 应用管理 → 自启动中打开。</string>
    <string name="rom_guide_generic">设置 → 电池 → 电池优化 中将护眼TV 设为「不优化」；并在系统管家中允许自启动与后台运行。</string>

